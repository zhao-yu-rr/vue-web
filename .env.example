# ======================================
# 环境变量示例文件（可提交到版本控制）
# ======================================
# 使用方式：复制此文件为 .env / .env.development / .env.production
# 并在对应文件中填写实际值
# 注意：只有以 VITE_ 开头的变量才会暴露给客户端代码
# 在组件中通过 import.meta.env.VITE_XXX 访问

# 应用标题
VITE_APP_TITLE=Vue Web 应用

# API 基础路径
# - 开发环境：指向本地后端（如 http://localhost:8080/api）
# - 生产环境：通常使用相对路径（如 /api）由 Nginx 代理转发
VITE_API_BASE_URL=http://localhost:8080/api

# 调试开关
VITE_DEBUG=true
